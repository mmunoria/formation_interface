# ============================ GOAL ============================
# Command the swarm to assume a named formation with the given geometry.
string formation             # one of: line, v, circle - or "custom" (see below)
float32 spacing              # spacing between neighbouring drones [m] (built-ins only)
float32 altitude             # target flight altitude, positive up [m]
geometry_msgs/Point center   # centre of the formation, world/ENU frame [m]
float32 yaw                  # heading the whole formation faces [rad]

# When formation == "custom": one offset per drone, relative to `center`, in the
# formation-local frame (rotated by yaw). z is an offset added to `altitude`,
# so custom formations may be 3-D. Length must equal the number of drones
# being commanded (see `drone_ids` below).
geometry_msgs/Point[] custom_offsets

# 1-indexed subset of drones to command (matches system_ids/pose_topics
# order in config/drones.yaml). Empty (default) = every configured drone,
# i.e. today's whole-swarm behaviour. A non-empty list lets one or more
# drones fly (with a path planned around every other known drone's current
# position, even if that drone was never targeted by this goal) without
# requiring a pose from drones outside this list.
int32[] drone_ids
---
# =========================== RESULT ===========================
bool success
string message
---
# ========================== FEEDBACK =========================
float32 progress             # 0.0 .. 1.0  (fraction of drones within tolerance)
uint8 drones_in_position
uint8 drones_total
float32 max_error            # worst per-drone distance to its target [m], -1 if unknown
